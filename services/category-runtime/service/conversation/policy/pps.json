      "pattern": "(?:проверя[ею]т|прос[яи]т|требу[ею]т).{0,25}(?:паспорт|удостовер|документ)|устанавлива.{0,12}личност|продолжа.{0,15}проверк.{0,15}личност",
      "requires": "reported_identity_check"
    },
    {
      "id": "delivery_to_station",
      "pattern": "(?:вез[её]т|везут|ехать|поехать|проехать|пройти|едем|ведут).{0,35}(?:отдел|участок|отделени)|(?:доставляют|доставили).{0,20}(?:полици|отдел)",
