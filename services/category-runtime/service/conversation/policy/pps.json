{
  "version": "pps-dialogue/20261022-v2",
  "categoryId": "pps",
  "defaultClarificationLimit": 2,
  "stageRules": [
    {
      "id": "street_stop",
      "pattern": "(?:остановил[аи]?|остановили|подош[её]л).{0,35}(?:улиц|полиц)|(?:на улице).{0,35}(?:останов|полиц)",
      "requires": "reported_street_contact"
