{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "АЙзащита — категория с тристатным NEXT и ссылками where_to",
  "description": "Структурная схема примера, не доказательство применимости ответов, полноценности категории, источника или готовности импорта.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "category",
    "metadata",
    "subcategories"
  ],
  "properties": {
    "category": {
      "$ref": "#/$defs/idName"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "format_version",
        "status",
        "example_only",
        "coverage",
        "assembled_on"
      ],
      "properties": {
        "format_version": {
          "const": "category-bundle/v2-links-only"
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "example_only": {
          "type": "boolean"
        },
        "coverage": {
          "enum": [
            "selected_variants",
            "full_category"
          ]
        },
        "assembled_on": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "subcategories": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/stage"
      }
    }
  },
  "$defs": {
    "idName": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "context_fields",
        "variants"
      ],
      "properties": {
        "stage": {
          "$ref": "#/$defs/idName"
        },
        "context_fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/idName"
          }
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/variant"
          }
        }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variant_id",
        "context",
        "question",
        "payload"
      ],
      "properties": {
        "variant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "context": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "category",
            "stage",
            "answer",
            "next"
          ],
          "properties": {
            "category": {
              "$ref": "#/$defs/idName"
            },
            "stage": {
              "$ref": "#/$defs/idName"
            },
            "answer": {
              "$ref": "#/$defs/answer"
            },
            "next": {
              "type": "array",
              "maxItems": 1,
              "items": {
                "$ref": "#/$defs/question"
              }
            }
          }
        }
      }
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "now",
        "steps",
        "dont",
        "say",
        "where_to",
        "laws"
      ],
      "properties": {
        "now": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dont": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "say": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "where_to": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/destination"
          }
        },
        "laws": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/law"
          }
        }
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "document_link_id"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "document_link_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[a-z][a-z0-9_-]*$"
        }
      }
    },
    "law": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "url",
        "title",
        "short"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^/laws/[^\\s?#]+\\.html(?:#[^\\s<>\"']+)?$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "short": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question",
        "type",
        "field_key",
        "data"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "choice"
        },
        "field_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "data": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/branch"
                },
                {
                  "type": "object",
                  "properties": {
                    "value": {
                      "const": true
                    },
                    "label": {
                      "const": "Да"
                    }
                  },
                  "required": [
                    "value",
                    "label"
                  ]
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/branch"
                },
                {
                  "type": "object",
                  "properties": {
                    "value": {
                      "const": false
                    },
                    "label": {
                      "const": "Нет"
                    }
                  },
                  "required": [
                    "value",
                    "label"
                  ]
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/branch"
                },
                {
                  "type": "object",
                  "properties": {
                    "value": {
                      "const": null
                    },
                    "label": {
                      "const": "Не знаю"
                    }
                  },
                  "required": [
                    "value",
                    "label"
                  ]
                }
              ]
            }
          ],
          "items": false
        }
      }
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "label"
      ],
      "properties": {
        "value": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "go_to_variant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "ask_next_question": {
          "$ref": "#/$defs/question"
        }
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "go_to_variant": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[a-z][a-z0-9_-]*$"
            }
          },
          "required": [
            "go_to_variant"
          ]
        },
        {
          "type": "object",
          "properties": {
            "ask_next_question": {
              "$ref": "#/$defs/question"
            }
          },
          "required": [
            "ask_next_question"
          ]
        }
      ]
    }
  }
}
